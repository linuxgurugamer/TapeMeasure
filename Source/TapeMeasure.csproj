  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <Target Name="CopyToGameData" AfterTargets="Build" Condition="'$(CopyToKSP)' == 'true'">
    <MakeDir Directories="$(KSPDIR)\GameData\TapeMeasure\Plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KSPDIR)\GameData\TapeMeasure\Plugins" />
    <MakeDir Directories="$(KSPDIR)\GameData\TapeMeasure\Textures" />
    <Copy SourceFiles="$(SolutionDir)GameData\TapeMeasure\Textures\icon_38.png;$(SolutionDir)GameData\TapeMeasure\Textures\icon_24.png;$(SolutionDir)GameData\TapeMeasure\Textures\icon_measure_38.png;$(SolutionDir)GameData\TapeMeasure\Textures\icon_measure_24.png;$(SolutionDir)GameData\TapeMeasure\Textures\cursor_measure.png" DestinationFolder="$(KSPDIR)\GameData\TapeMeasure\Textures" />
    <Copy SourceFiles="$(SolutionDir)TapeMeasure.version" DestinationFolder="$(KSPDIR)\GameData\TapeMeasure" />
    <MakeDir Directories="$(KSPDIR)\GameData\TapeMeasure\PluginData\DeltaVTables" />
    <Copy SourceFiles="@(DeltaVTableFile)" DestinationFolder="$(KSPDIR)\GameData\TapeMeasure\PluginData\DeltaVTables" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(SolutionDir)GameData\TapeMeasure\BulkheadProfiles.cfg;$(SolutionDir)GameData\TapeMeasure\decouplerMasses.cfg" DestinationFolder="$(KSPDIR)\GameData\TapeMeasure" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <PropertyGroup>
    <PreBuildEvent>"$(DevEnvDir)\texttransform.exe" "$(ProjectDir)AssemblyVersion.tt"</PreBuildEvent>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>set KSPDIR=$(KSPDIR)

IF "%25KSPDIR%25"=="" (

	ECHO Configuration error - KSPDIR not specified in project.

	ECHO Either set KSPDIR environment variable or edit BetterLoadSaveGame.Common.props

	PAUSE

	GOTO DONE

)

start /D $(SolutionDir) /WAIT deploy.bat  $(TargetDir) $(TargetFileName) $(TargetName)

if $(ConfigurationName) == Release (	

	start /D $(SolutionDir) /WAIT buildRelease.bat $(TargetDir) $(TargetFileName) $(TargetName)

)
</PostBuildEvent>
  </PropertyGroup>
</Project>